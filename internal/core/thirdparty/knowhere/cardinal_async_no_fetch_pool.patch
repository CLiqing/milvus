+inline std::optional<size_t> cardinalEnvSizeT(const char* name) {
+    const char* value = std::getenv(name);
+    if (value == nullptr || value[0] == '\0') {
+        return std::nullopt;
+    }
+    char* endptr = nullptr;
+    errno = 0;
+    unsigned long parsed = std::strtoul(value, &endptr, 10);
+    if (errno == ERANGE || endptr == value || *endptr != '\0' || parsed == 0) {
+        LOG_KNOWHERE_WARNING_ << "Ignore invalid Cardinal env override " << name << "=" << value;
+        return std::nullopt;
+    }
+    return static_cast<size_t>(parsed);
+}
