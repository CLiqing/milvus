+            flags |= CURL_CSELECT_IN;
+          }
+          if ((events[i].events & EPOLLOUT) != 0) {
+            flags |= CURL_CSELECT_OUT;
+          }
+          if ((events[i].events & (EPOLLERR | EPOLLHUP)) != 0) {
+            flags |= CURL_CSELECT_ERR;
