+      CURLMcode code = curl_multi_add_handle(multi_, request->easy);
+      if (code != CURLM_OK) {
+        std::string error = curl_multi_strerror(code);
+        curl_easy_cleanup(request->easy);
+        request->easy = nullptr;
+        FinishWithoutCurl(std::move(request), error);
