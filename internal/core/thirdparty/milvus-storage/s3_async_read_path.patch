+void RunS3CrtGetObject(const S3Options& options,
+                       const S3Path& path,
+                       int64_t position,
+                       int64_t nbytes,
+                       Future<std::shared_ptr<Buffer>> future,
+                       std::shared_ptr<ResizableBuffer> buffer,
+                       std::shared_ptr<S3ClientLock> client_lock_holder) {
