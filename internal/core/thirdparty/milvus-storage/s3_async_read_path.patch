+      }
+      active_[request->easy] = std::move(request);
+      UpdateMax(GetCurlMultiStats().max_active, active_.size());
+      auto& stats = GetCurlMultiStats();
+      const auto active_global = stats.active_global.fetch_add(1, std::memory_order_relaxed) + 1;
+      UpdateMax(stats.max_active_global, active_global);
+    }
+
+    void CompleteFinished() {
