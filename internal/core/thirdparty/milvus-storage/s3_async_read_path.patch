+class CurlMultiReadExecutor {
+ public:
+  explicit CurlMultiReadExecutor(size_t event_loop_count) {
+    static std::once_flag curl_global_init_once;
+    std::call_once(curl_global_init_once, []() { curl_global_init(CURL_GLOBAL_DEFAULT); });
