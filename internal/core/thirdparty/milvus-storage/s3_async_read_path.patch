+    void Wake() {
+      GetCurlMultiStats().wake_calls.fetch_add(1, std::memory_order_relaxed);
+      uint64_t value = 1;
+      ssize_t ignored = write(event_fd_, &value, sizeof(value));
+      (void)ignored;
+    }
+
+    void DrainFd(int fd) {
+      uint64_t value = 0;
+      while (read(fd, &value, sizeof(value)) == sizeof(value)) {
+      }
+    }
+
+    void Run() {
+      while (true) {
+        if (AddPending()) {
+          int running = 0;
+          curl_multi_socket_action(multi_, CURL_SOCKET_TIMEOUT, 0, &running);
+          CompleteFinished();
