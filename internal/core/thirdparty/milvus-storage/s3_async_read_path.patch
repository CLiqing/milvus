+    event_loop_count = std::max<size_t>(event_loop_count, 1);
+    loops_.reserve(event_loop_count);
+    for (size_t i = 0; i < event_loop_count; ++i) {
+      loops_.push_back(std::make_unique<Loop>(*this));
+    }
+    for (auto& loop : loops_) {
