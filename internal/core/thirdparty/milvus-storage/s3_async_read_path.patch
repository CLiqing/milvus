+        }
+
+        epoll_event events[64];
+        int count = epoll_wait(epoll_fd_, events, 64, -1);
+        if (count < 0) {
+          if (errno == EINTR) {
+            continue;
+          }
+          break;
+        }
+        GetCurlMultiStats().epoll_wait_returns.fetch_add(1, std::memory_order_relaxed);
+        GetCurlMultiStats().epoll_events.fetch_add(static_cast<uint64_t>(count),
+                                                   std::memory_order_relaxed);
+
+        for (int i = 0; i < count; ++i) {
+          int fd = events[i].data.fd;
+          if (fd == event_fd_) {
+            GetCurlMultiStats().eventfd_wakes.fetch_add(1, std::memory_order_relaxed);
+            DrainFd(event_fd_);
+            if (AddPending()) {
