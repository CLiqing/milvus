+ private:
+  std::unique_ptr<Aws::Crt::Io::EventLoopGroup> event_loop_group_;
+  std::unique_ptr<Aws::Crt::Io::DefaultHostResolver> host_resolver_;
+  std::shared_ptr<Aws::Crt::Io::ClientBootstrap> bootstrap_;
