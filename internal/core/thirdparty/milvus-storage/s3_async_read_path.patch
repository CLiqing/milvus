+          curl_multi_remove_handle(multi_, easy);
+          curl_easy_cleanup(easy);
+          continue;
+        }
+
+        auto request = std::move(iter->second);
+        active_.erase(iter);
+        GetCurlMultiStats().active_global.fetch_sub(1, std::memory_order_relaxed);
