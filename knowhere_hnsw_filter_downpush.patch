+inline int64_t
+DemoHnswFilterThreshold() {
+    static const int64_t threshold = [] {
+        const char* env = getenv("MILVUS_DEMO_HNSW_FILTER_THRESHOLD");
+        if (env == nullptr || env[0] == '\0') {
